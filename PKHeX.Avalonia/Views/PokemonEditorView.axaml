<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PKHeX.Avalonia.ViewModels"
             x:Class="PKHeX.Avalonia.Views.PokemonEditorView"
             x:DataType="vm:PokemonEditorViewModel">
  <Panel>

    <!-- Empty state -->
    <TextBlock Text="Select a Pokémon to edit"
               FontStyle="Italic"
               Foreground="#90A4AE"
               FontSize="14"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsVisible="{Binding !HasPokemon}" />

    <!-- Editor -->
    <ScrollViewer IsVisible="{Binding HasPokemon}" Padding="2">
      <StackPanel>

        <!-- ── Header: species + legality badge ───────────────── -->
        <Border Classes="card">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
              <Image Source="{Binding Sprite}" Stretch="Uniform"
                     Width="68" Height="56"
                     VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Text="{Binding Species}"
                         FontSize="20" FontWeight="Bold"
                         Foreground="#263238"
                         VerticalAlignment="Center" />
              <Border Background="#FFF3CD" CornerRadius="3"
                      Padding="6,2" Margin="10,0,0,0"
                      VerticalAlignment="Center"
                      IsVisible="{Binding IsShiny}">
                <TextBlock Text="★ Shiny" FontSize="11" Foreground="#8A6D00" />
              </Border>
            </StackPanel>

            <Border Grid.Column="1"
                    Classes="badge"
                    Classes.ok="{Binding IsLegal}"
                    Classes.bad="{Binding !IsLegal}"
                    CornerRadius="4" Padding="10,5"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding LegalityStatus}"
                         FontWeight="SemiBold" FontSize="12" />
            </Border>
          </Grid>
        </Border>

        <!-- ── Identity ───────────────────────────────────────── -->
        <Border Classes="card">
          <StackPanel>
            <TextBlock Classes="h2" Text="Identity" />
            <Grid ColumnDefinitions="100,*,16,100,*" RowDefinitions="Auto,Auto,Auto">

              <!-- Row 0 -->
              <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Nickname" Margin="0,0,8,8" />
              <TextBox   Grid.Row="0" Grid.Column="1" Classes="field" Text="{Binding Nickname}" Margin="0,0,0,8" />
              <TextBlock Grid.Row="0" Grid.Column="3" Classes="label" Text="Level" Margin="0,0,8,8" />
              <NumericUpDown Grid.Row="0" Grid.Column="4"
                            Value="{Binding Level}" Minimum="1" Maximum="100"
                            Increment="1" FormatString="0"
                            HorizontalAlignment="Stretch" Margin="0,0,0,8" />

              <!-- Row 1 -->
              <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="OT Name" Margin="0,0,8,8" />
              <TextBox   Grid.Row="1" Grid.Column="1" Classes="field" Text="{Binding OtName}" Margin="0,0,0,8" />
              <TextBlock Grid.Row="1" Grid.Column="3" Classes="label" Text="Gender" Margin="0,0,8,8" />
              <ComboBox  Grid.Row="1" Grid.Column="4" Classes="field"
                         ItemsSource="{Binding GenderOptions}"
                         SelectedIndex="{Binding SelectedGenderIndex}" Margin="0,0,0,8" />

              <!-- Row 2 -->
              <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                        Content="Shiny" IsChecked="{Binding IsShiny}" />
              <CheckBox Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2"
                        Content="Nicknamed" IsChecked="{Binding IsNicknamed}" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- ── Nature / Ability / Item ────────────────────────── -->
        <Border Classes="card">
          <StackPanel>
            <TextBlock Classes="h2" Text="Characteristics" />
            <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Nature" Margin="0,0,8,8" />
              <ComboBox  Grid.Row="0" Grid.Column="1" Classes="field"
                         ItemsSource="{Binding NatureOptions}"
                         SelectedIndex="{Binding SelectedNatureIndex}" Margin="0,0,0,8" />

              <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Ability" Margin="0,0,8,8" />
              <ComboBox  Grid.Row="1" Grid.Column="1" Classes="field"
                         ItemsSource="{Binding AbilityOptions}"
                         SelectedIndex="{Binding SelectedAbilityIndex}" Margin="0,0,0,8" />

              <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Held Item" />
              <ComboBox  Grid.Row="2" Grid.Column="1" Classes="field"
                         ItemsSource="{Binding ItemOptions}"
                         SelectedIndex="{Binding SelectedItemIndex}" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- ── Moves ──────────────────────────────────────────── -->
        <Border Classes="card">
          <StackPanel>
            <TextBlock Classes="h2" Text="Moves" />
            <Grid ColumnDefinitions="70,*,16,70,*" RowDefinitions="Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Move 1" Margin="0,0,8,8" />
              <ComboBox  Grid.Row="0" Grid.Column="1" Classes="field"
                         ItemsSource="{Binding MoveOptions}"
                         SelectedIndex="{Binding SelectedMove1Index}" Margin="0,0,0,8" />
              <TextBlock Grid.Row="0" Grid.Column="3" Classes="label" Text="Move 2" Margin="0,0,8,8" />
              <ComboBox  Grid.Row="0" Grid.Column="4" Classes="field"
                         ItemsSource="{Binding MoveOptions}"
                         SelectedIndex="{Binding SelectedMove2Index}" Margin="0,0,0,8" />

              <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Move 3" />
              <ComboBox  Grid.Row="1" Grid.Column="1" Classes="field"
                         ItemsSource="{Binding MoveOptions}"
                         SelectedIndex="{Binding SelectedMove3Index}" />
              <TextBlock Grid.Row="1" Grid.Column="3" Classes="label" Text="Move 4" />
              <ComboBox  Grid.Row="1" Grid.Column="4" Classes="field"
                         ItemsSource="{Binding MoveOptions}"
                         SelectedIndex="{Binding SelectedMove4Index}" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- ── Stats (IV / EV) ────────────────────────────────── -->
        <Border Classes="card">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Classes="h2" Text="Stats" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                <TextBlock Classes="label" VerticalAlignment="Center"
                           Text="{Binding IvTotal, StringFormat='IV {0}/186'}" />
                <TextBlock Classes="label" VerticalAlignment="Center"
                           Text="{Binding EvTotal, StringFormat='EV {0}/510'}" />
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="70,90,*,90" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
              <!-- header -->
              <TextBlock Grid.Row="0" Grid.Column="1" Text="IV (0–31)"
                         FontSize="11" Foreground="#78909C" HorizontalAlignment="Center" Margin="0,0,0,4" />
              <TextBlock Grid.Row="0" Grid.Column="3" Text="EV (0–252)"
                         FontSize="11" Foreground="#78909C" HorizontalAlignment="Center" Margin="0,0,0,4" />

              <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="HP" Margin="0,0,8,6" />
              <NumericUpDown Grid.Row="1" Grid.Column="1" Classes="stat" Value="{Binding IvHp}"  Minimum="0" Maximum="31"  FormatString="0" Margin="0,0,8,6" />
              <NumericUpDown Grid.Row="1" Grid.Column="3" Classes="stat" Value="{Binding EvHp}"  Minimum="0" Maximum="252" FormatString="0" Margin="0,0,0,6" />

              <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Attack" Margin="0,0,8,6" />
              <NumericUpDown Grid.Row="2" Grid.Column="1" Classes="stat" Value="{Binding IvAtk}" Minimum="0" Maximum="31"  FormatString="0" Margin="0,0,8,6" />
              <NumericUpDown Grid.Row="2" Grid.Column="3" Classes="stat" Value="{Binding EvAtk}" Minimum="0" Maximum="252" FormatString="0" Margin="0,0,0,6" />

              <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="Defense" Margin="0,0,8,6" />
              <NumericUpDown Grid.Row="3" Grid.Column="1" Classes="stat" Value="{Binding IvDef}" Minimum="0" Maximum="31"  FormatString="0" Margin="0,0,8,6" />
              <NumericUpDown Grid.Row="3" Grid.Column="3" Classes="stat" Value="{Binding EvDef}" Minimum="0" Maximum="252" FormatString="0" Margin="0,0,0,6" />

              <TextBlock Grid.Row="4" Grid.Column="0" Classes="label" Text="Sp. Atk" Margin="0,0,8,6" />
              <NumericUpDown Grid.Row="4" Grid.Column="1" Classes="stat" Value="{Binding IvSpa}" Minimum="0" Maximum="31"  FormatString="0" Margin="0,0,8,6" />
              <NumericUpDown Grid.Row="4" Grid.Column="3" Classes="stat" Value="{Binding EvSpa}" Minimum="0" Maximum="252" FormatString="0" Margin="0,0,0,6" />

              <TextBlock Grid.Row="5" Grid.Column="0" Classes="label" Text="Sp. Def" Margin="0,0,8,6" />
              <NumericUpDown Grid.Row="5" Grid.Column="1" Classes="stat" Value="{Binding IvSpd}" Minimum="0" Maximum="31"  FormatString="0" Margin="0,0,8,6" />
              <NumericUpDown Grid.Row="5" Grid.Column="3" Classes="stat" Value="{Binding EvSpd}" Minimum="0" Maximum="252" FormatString="0" Margin="0,0,0,6" />

              <TextBlock Grid.Row="6" Grid.Column="0" Classes="label" Text="Speed" Margin="0,0,8,0" />
              <NumericUpDown Grid.Row="6" Grid.Column="1" Classes="stat" Value="{Binding IvSpe}" Minimum="0" Maximum="31"  FormatString="0" Margin="0,0,8,0" />
              <NumericUpDown Grid.Row="6" Grid.Column="3" Classes="stat" Value="{Binding EvSpe}" Minimum="0" Maximum="252" FormatString="0" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Classes="tool" Content="Max IVs"  Command="{Binding MaxIVsCommand}"  Margin="0,0,8,0" />
              <Button Classes="tool" Content="Max EVs"  Command="{Binding MaxEVsCommand}"  Margin="0,0,8,0" />
              <Button Classes="tool" Content="Zero EVs" Command="{Binding ZeroEVsCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ── Legality report ────────────────────────────────── -->
        <Expander Header="Legality Report" IsExpanded="True" Margin="0,0,0,10">
          <Border Background="#FAFAFA" CornerRadius="4" Padding="10">
            <SelectableTextBlock Text="{Binding LegalityReport}"
                                 FontFamily="monospace"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 Foreground="#37474F" />
          </Border>
        </Expander>

        <!-- ── Apply ──────────────────────────────────────────── -->
        <Button Classes="primary"
                Content="Apply Changes"
                Command="{Binding ApplyChangesCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Margin="0,0,0,4" />

      </StackPanel>
    </ScrollViewer>
  </Panel>
</UserControl>
