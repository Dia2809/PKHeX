<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PKHeX.Avalonia.ViewModels"
        xmlns:views="using:PKHeX.Avalonia.Views"
        x:Class="PKHeX.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PKHeX"
        Width="1120" Height="740"
        MinWidth="860" MinHeight="600"
        Background="#ECEFF1">

    <DockPanel>

        <!-- ═══ Menu bar ═══ -->
        <Menu DockPanel.Dock="Top" Background="White">
            <MenuItem Header="_File">
                <MenuItem Header="_Open…" Command="{Binding OpenSaveCommand}" InputGesture="Ctrl+O" />
                <MenuItem Header="_Save"  Command="{Binding SaveCommand}"     InputGesture="Ctrl+S" />
                <MenuItem Header="Save _As…" Command="{Binding SaveAsCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
        </Menu>

        <!-- ═══ Status bar ═══ -->
        <Border DockPanel.Dock="Bottom"
                Background="White"
                BorderBrush="#CFD8DC" BorderThickness="0,1,0,0"
                Padding="10,5">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="12" Foreground="#546E7A"
                       VerticalAlignment="Center" />
        </Border>

        <!-- ═══ Main content ═══ -->
        <Grid ColumnDefinitions="380,4,*">

            <!-- ── Left sidebar ── -->
            <Border Grid.Column="0" Background="#FAFAFA"
                    BorderBrush="#CFD8DC" BorderThickness="0,0,1,0">
                <DockPanel Margin="8">

                    <!-- Trainer card (always visible above tabs) -->
                    <Border DockPanel.Dock="Top"
                            Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                            CornerRadius="6" Padding="10" Margin="0,0,0,8"
                            BoxShadow="0 1 3 0 #11000000">
                        <Panel>
                            <TextBlock Text="No save file loaded"
                                       FontStyle="Italic" Foreground="#90A4AE"
                                       HorizontalAlignment="Center" Margin="0,8"
                                       IsVisible="{Binding !HasSave}" />
                            <Grid IsVisible="{Binding HasSave}"
                                  ColumnDefinitions="Auto,*"
                                  RowDefinitions="Auto,Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Trainer" Classes="kv-key" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TrainerName}" Classes="kv-val" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Game" Classes="kv-key" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GameVersion}" Classes="kv-val" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="ID" Classes="kv-key" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TrainerID}" Classes="kv-val" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Money" Classes="kv-key" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Money}" Classes="kv-val" />
                            </Grid>
                        </Panel>
                    </Border>

                    <!-- Tabs: Box / Party / SAV -->
                    <TabControl DockPanel.Dock="Top">

                        <!-- ── Box tab ──────────────────────────────── -->
                        <TabItem Header="Box">
                            <DockPanel Margin="0,6,0,0">

                                <!-- Box selector -->
                                <ComboBox DockPanel.Dock="Top"
                                          ItemsSource="{Binding BoxNames}"
                                          SelectedIndex="{Binding CurrentBoxIndex}"
                                          IsEnabled="{Binding HasSave}"
                                          HorizontalAlignment="Stretch"
                                          Margin="0,0,0,6" />

                                <!-- Box slots — ListBox gives arrow-key navigation for free.
                                     WrapPanel arranges 6 items per row (52+2px each ≈ 324px). -->
                                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                                        CornerRadius="6" Padding="4">
                                    <ScrollViewer>
                                        <ListBox ItemsSource="{Binding CurrentBoxSlots}"
                                                 SelectedItem="{Binding SelectedBoxSlot}"
                                                 Background="Transparent"
                                                 BorderThickness="0">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <!-- Classes can't be set via a Setter; all per-state
                                                 overrides go here as scoped ListBox.Styles. -->
                                            <ListBox.Styles>
                                                <Style Selector="ListBoxItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="1" />
                                                    <Setter Property="CornerRadius" Value="5" />
                                                    <Setter Property="Width" Value="54" />
                                                    <Setter Property="Height" Value="48" />
                                                </Style>
                                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="Transparent" />
                                                </Style>
                                                <Style Selector="ListBoxItem:selected">
                                                    <Setter Property="BorderBrush" Value="#1565C0" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </Style>
                                                <Style Selector="ListBoxItem:focus-visible">
                                                    <Setter Property="BorderBrush" Value="#1565C0" />
                                                    <Setter Property="BorderThickness" Value="3" />
                                                </Style>
                                                <Style Selector="ListBoxItem:pointerover">
                                                    <Setter Property="BorderBrush" Value="#42A5F5" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </Style>
                                            </ListBox.Styles>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SlotViewModel">
                                                    <!-- ToolTip goes on the content panel, not a Style Setter,
                                                         to keep compiled-binding mode happy. -->
                                                    <Panel Width="50" Height="44"
                                                           ToolTip.Tip="{Binding ToolTipText}">
                                                        <Border Background="{Binding Background}"
                                                                CornerRadius="4"
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Stretch" />
                                                        <Image Source="{Binding Sprite}"
                                                               Stretch="Uniform"
                                                               Width="46" Height="40"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                        <Image Source="{Binding ItemSprite}"
                                                               Width="15" Height="15"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Bottom" />
                                                        <TextBlock Text="★"
                                                                   IsVisible="{Binding ShowShinyStar}"
                                                                   Foreground="#FFC107"
                                                                   FontSize="11"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Top" />
                                                    </Panel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </ScrollViewer>
                                </Border>

                            </DockPanel>
                        </TabItem>

                        <!-- ── Party tab ────────────────────────────── -->
                        <TabItem Header="Party">
                            <Border Margin="0,6,0,0" Background="White" BorderBrush="#E0E0E0"
                                    BorderThickness="1" CornerRadius="6" Padding="4">

                                <!-- Party ListBox — Up/Down arrows navigate the 6 slots -->
                                <ListBox ItemsSource="{Binding PartySlots}"
                                         SelectedItem="{Binding SelectedPartySlot}"
                                         Background="Transparent"
                                         BorderThickness="0">
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="2,2" />
                                            <Setter Property="CornerRadius" Value="5" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                        <Style Selector="ListBoxItem:selected">
                                            <Setter Property="BorderBrush" Value="#1565C0" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </Style>
                                        <Style Selector="ListBoxItem:focus-visible">
                                            <Setter Property="BorderBrush" Value="#1565C0" />
                                            <Setter Property="BorderThickness" Value="3" />
                                        </Style>
                                        <Style Selector="ListBoxItem:pointerover">
                                            <Setter Property="BorderBrush" Value="#42A5F5" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SlotViewModel">
                                            <Grid ColumnDefinitions="56,*,Auto" MinHeight="52"
                                                  ToolTip.Tip="{Binding ToolTipText}">
                                                <Panel Grid.Column="0">
                                                    <Border Background="{Binding Background}"
                                                            CornerRadius="4"
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Stretch" />
                                                    <Image Source="{Binding Sprite}"
                                                           Stretch="Uniform"
                                                           Width="52" Height="44"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                    <Image Source="{Binding ItemSprite}"
                                                           Width="14" Height="14"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Bottom" />
                                                </Panel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayText}"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Foreground="#37474F"
                                                           Margin="6,0" />
                                                <TextBlock Grid.Column="2"
                                                           Text="★"
                                                           IsVisible="{Binding ShowShinyStar}"
                                                           Foreground="#FFC107"
                                                           FontSize="13"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                            </Border>
                        </TabItem>

                        <!-- ── SAV tab ──────────────────────────────── -->
                        <TabItem Header="SAV">
                            <ScrollViewer Margin="0,6,0,0">
                                <StackPanel Spacing="8">
                                    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                                            CornerRadius="6" Padding="10">
                                        <Grid ColumnDefinitions="Auto,*"
                                              RowDefinitions="Auto,Auto,Auto,Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Generation" Classes="kv-key" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SavGeneration}" Classes="kv-val" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Game" Classes="kv-key" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SavGameCode}" Classes="kv-val" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Language" Classes="kv-key" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SavLanguage}" Classes="kv-val" />
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Play Time" Classes="kv-key" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PlayTime}" Classes="kv-val" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="No save loaded"
                                               IsVisible="{Binding !HasSave}"
                                               FontStyle="Italic" Foreground="#90A4AE"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                    </TabControl>

                </DockPanel>
            </Border>

            <!-- ── Splitter ── -->
            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          HorizontalAlignment="Stretch"
                          Background="#ECEFF1" />

            <!-- ── Right panel: Pokémon editor ── -->
            <views:PokemonEditorView Grid.Column="2"
                                     DataContext="{Binding PokemonEditor}"
                                     Margin="12,12,8,12" />

        </Grid>

    </DockPanel>
</Window>
