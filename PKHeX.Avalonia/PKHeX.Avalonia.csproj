<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Supports linux-x64, linux-arm64, win-x64, osx-arm64, osx-x64 -->
    <RuntimeIdentifiers>linux-x64;linux-arm64;win-x64;osx-arm64;osx-x64</RuntimeIdentifiers>
    <AssemblyName>PKHeX.Avalonia</AssemblyName>
    <RootNamespace>PKHeX.Avalonia</RootNamespace>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindings>true</AvaloniaUseCompiledBindings>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Update these to the latest Avalonia release: https://www.nuget.org/packages/Avalonia -->
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <!-- Force a patched version of the transitive Avalonia → Tmds.DBus.Protocol
         dependency to eliminate the high-severity advisory GHSA-xrw6-gwf8-vvr9. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PKHeX.Core/PKHeX.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <!-- Embed PKHeX's loose PNG sprites (shared with the WinForms project) so the
       Avalonia app renders real Pokémon/item images on any platform. The Link
       flattens each set into a logical Assets folder for clean avares:// URIs. -->
  <ItemGroup>
    <AvaloniaResource Include="..\PKHeX.Drawing.PokeSprite\Resources\img\Big Pokemon Sprites\*.png">
      <Link>Assets\sprites\%(Filename)%(Extension)</Link>
    </AvaloniaResource>
    <AvaloniaResource Include="..\PKHeX.Drawing.PokeSprite\Resources\img\Big Shiny Sprites\*.png">
      <Link>Assets\sprites\%(Filename)%(Extension)</Link>
    </AvaloniaResource>
    <AvaloniaResource Include="..\PKHeX.Drawing.PokeSprite\Resources\img\Big Items\*.png">
      <Link>Assets\items\%(Filename)%(Extension)</Link>
    </AvaloniaResource>
  </ItemGroup>

</Project>
